<section class="map-block home__section">
  <%= content_tag("h3", section_title) if section_title.present? %>

  <%= awesome_map_for global_map_components do %>
    <%= render partial: "decidim/decidim_awesome/map_component/map/map_template.html", locals: { taxonomies: all_taxonomies, map_height: model.settings.map_height } %>
  <% end %>
</section>

<% show_accountability_results = model.settings.respond_to?(:show_accountability_results) && model.settings.show_accountability_results %>
<% if show_accountability_results %>
<script id="marker-result-popup" type="text/x-jsrender">
  <div class="space-y-6">
    <div class="card__list">
      <div class="card__list-content">
        <a href="{{>url}}" target="result">
          <h3 class="h4 card__list-title">{{:titleText}}</h3>
          <div class="card__list-metadata">
            <span class="label muted"><%= t("activerecord.models.decidim/accountability/result", count: 1) %></span>
          </div>
          {{if address}}
            <div class="text-sm">{{>address}}</div>
          {{/if}}
        </a>
        {{if descriptionText}}
          <div class="description">
            {{:descriptionText}}
          </div>
        {{/if}}
      </div>
    </div>
  </div>
</script>
<% end %>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const districtCouncilLayerUrl = "/geo/consells-de-barri.geojson";
    let districtCouncilBoundariesLayer = null;
    const districtCouncilColors = {
      "Centre": "#fec544",
      "Les Planes": "#5bb357",
      "Mira-sol": "#33bad3",
      "Mira Sol": "#33bad3",
      "La Floresta": "#ed3596",
      "Volpelleres": "#f47721"
    };
    const defaultDistrictCouncilColor = "#165b69";
    const configuredMapZoom = <%= model.settings.map_zoom.present? ? model.settings.map_zoom.to_i : "null" %>;
    const showAccountabilityResults = <%= show_accountability_results ? "true" : "false" %>;
    const components = <%= show_accountability_results ? accountability_map_components.map { |component|
      {
        id: component.id,
        url: Decidim::EngineRouter.main_proxy(component).root_path
      }
    }.to_json.html_safe : [].to_json.html_safe %>;

    const query = `query ($id: ID!, $after: String!) {
      component(id: $id) {
        ... on Accountability {
          results(first: 50, after: $after) {
            pageInfo {
              hasNextPage
              endCursor
            }
            edges {
              node {
                id
                url
                address
                coordinates {
                  latitude
                  longitude
                }
                title {
                  translations {
                    text
                    locale
                  }
                }
                description {
                  translations {
                    text
                    locale
                  }
                }
                taxonomies {
                  id
                }
              }
            }
          }
        }
      }
    }`;

    const htmlLang = document.documentElement.getAttribute("lang");

    const hideLoadingSpinner = (awesomeMap) => {
      if (awesomeMap.controls && awesomeMap.controls.loading) {
        awesomeMap.controls.loading.style.display = "none";
      }
    };

    const districtCouncilColorFor = (feature) => {
      const name = feature?.properties?.name;
      return districtCouncilColors[name] || defaultDistrictCouncilColor;
    };

    const fitMapToVisibleData = (awesomeMap) => {
      let bounds = districtCouncilBoundariesLayer ? districtCouncilBoundariesLayer.getBounds() : null;

      if ((!bounds || !bounds.isValid()) && awesomeMap.cluster && awesomeMap.cluster.getLayers().length > 0) {
        const clusterBounds = awesomeMap.cluster.getBounds();
        bounds = clusterBounds;
      }

      if (bounds && bounds.isValid()) {
        window.requestAnimationFrame(() => {
          awesomeMap.map.invalidateSize(false);
          awesomeMap.map.fitBounds(bounds, { padding: [24, 24], animate: false });

          if (Number.isInteger(configuredMapZoom) && configuredMapZoom > 0) {
            awesomeMap.map.setZoom(configuredMapZoom);
          }
        });
      }
    };

    const addDistrictCouncilBoundaries = (awesomeMap) => {
      fetch(districtCouncilLayerUrl)
        .then((response) => {
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          return response.json();
        })
        .then((featureCollection) => {
          if (!featureCollection || !Array.isArray(featureCollection.features) || !featureCollection.features.length) return;

          const paneName = "district-council-boundaries";
          let pane = awesomeMap.map.getPane(paneName);

          if (!pane) {
            pane = awesomeMap.map.createPane(paneName);
            pane.style.zIndex = 350;
            pane.style.pointerEvents = "none";
          }

          districtCouncilBoundariesLayer = L.geoJSON(featureCollection, {
            pane: paneName,
            style: (feature) => {
              const color = districtCouncilColorFor(feature);

              return {
                color,
                weight: 2,
                opacity: 0.95,
                fillColor: color,
                fillOpacity: 0.2,
                dashArray: "6 4"
              };
            }
          });

          districtCouncilBoundariesLayer.addTo(awesomeMap.map);
          districtCouncilBoundariesLayer.bringToBack();
          hideLoadingSpinner(awesomeMap);
          fitMapToVisibleData(awesomeMap);
        })
        .catch((error) => {
          console.error("Failed to load district council boundaries", error);
        });
    };

    const findTranslation = (field) => {
      const translations = field?.translations || [];
      let fallback = "";

      translations.forEach((translation) => {
        if (!translation.text) return;
        if (!fallback) fallback = translation.text;
        if (translation.locale === htmlLang) fallback = translation.text;
      });

      return fallback;
    };

    const addTaxonomies = (awesomeMap, marker, node) => {
      if (!node.taxonomies || !node.taxonomies.length) return;

      node.taxonomies.forEach((taxonomy) => {
        const tax = awesomeMap.getTaxonomy(taxonomy);
        if (awesomeMap.layers[tax.id] && awesomeMap.layers[tax.id].group) {
          try {
            awesomeMap.layers[tax.id].group.addLayer(marker);
            if (awesomeMap.controls && awesomeMap.controls.showTaxonomy) {
              awesomeMap.controls.showTaxonomy(tax);
            }
          } catch (error) {
            console.error("Failed taxonomy marker assignation", taxonomy, error);
          }
        }
      });
    };

    const createResultIcon = (awesomeMap, node) => {
      const color = awesomeMap.getTaxonomy(node.taxonomies && node.taxonomies[0]).color;
      const size = 36;

      return L.divIcon({
        html: `
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="${size}px" height="${size}px" class="text-secondary" style="color: ${color}"><path fill="none" d="M0 0h24v24H0z"/><path fill="currentColor" d="M18.364 17.364L12 23.728l-6.364-6.364a9 9 0 1 1 12.728 0zM12 15a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm0-2a2 2 0 1 1 0-4 2 2 0 0 1 0 4z"/></svg>`,
        iconAnchor: [0.5 * size, size],
        popupAnchor: [0, -0.5 * size]
      });
    };

    const addResultMarker = (awesomeMap, component, node) => {
      if (!node.coordinates || node.coordinates.latitude == null || node.coordinates.longitude == null) return;

      node.titleText = findTranslation(node.title);
      node.descriptionText = findTranslation(node.description);
      node.url = node.url || `${component.url}/results/${node.id}`;

      const marker = new L.Marker([node.coordinates.latitude, node.coordinates.longitude], {
        keyboard: true,
        title: node.titleText,
        icon: createResultIcon(awesomeMap, node)
      });

      marker.on("click", () => {
        const dom = document.createElement("div");
        dom.innerHTML = $.templates("#marker-result-popup").render(node);
        const popup = L.popup({
          maxwidth: 640,
          minWidth: 500,
          keepInView: true,
          className: "map-info"
        }).setLatLng(marker.getLatLng()).setContent(dom);
        awesomeMap.map.addLayer(popup);
      });

      awesomeMap.cluster.addLayer(marker);
      addTaxonomies(awesomeMap, marker, node);
    };

    const startResultsLoading = (awesomeMap, component) => {
      const loadingKey = `accountability-${component.id}`;
      awesomeMap.loading = Array.isArray(awesomeMap.loading) ? awesomeMap.loading : [];

      if (!awesomeMap.loading.includes(loadingKey)) {
        awesomeMap.loading.push(loadingKey);
      }

      if (awesomeMap.controls && awesomeMap.controls.loading) {
        awesomeMap.controls.loading.style.display = "none";
      }

      return loadingKey;
    };

    const finishResultsLoading = (awesomeMap, loadingKey) => {
      if (!Array.isArray(awesomeMap.loading)) return;

      const loadingIndex = awesomeMap.loading.indexOf(loadingKey);
      if (loadingIndex >= 0) {
        awesomeMap.loading.splice(loadingIndex, 1);
      }

      if (awesomeMap.loading.length === 0 && awesomeMap.controls && awesomeMap.controls.loading) {
        awesomeMap.controls.loading.style.display = "none";
      }
    };

    const fetchResults = (awesomeMap, component, loadingKey, after = "") => {
      $.ajax({
        method: "POST",
        url: "/api",
        contentType: "application/json",
        data: JSON.stringify({
          query,
          variables: { id: component.id, after }
        })
      }).done((response) => {
        const collection = response?.data?.component?.results;
        if (!collection) {
          finishResultsLoading(awesomeMap, loadingKey);
          return;
        }

        (collection.edges || []).forEach((edge) => {
          if (!edge || !edge.node) return;
          addResultMarker(awesomeMap, component, edge.node);
        });

        if (collection.pageInfo && collection.pageInfo.hasNextPage) {
          fetchResults(awesomeMap, component, loadingKey, collection.pageInfo.endCursor || "");
        } else {
          fitMapToVisibleData(awesomeMap);
          finishResultsLoading(awesomeMap, loadingKey);
        }
      }).fail((error) => {
        console.error("Failed to fetch accountability results", component.id, error);
        finishResultsLoading(awesomeMap, loadingKey);
      });
    };

    const hideDefaultLayers = (awesomeMap, attemptsLeft = 20) => {
      const proposalsToggles = document.querySelectorAll(".awesome_map-component[data-layer='proposals']");
      const meetingsToggles = document.querySelectorAll(".awesome_map-component[data-layer='meetings']");
      const hasToggles = proposalsToggles.length > 0 || meetingsToggles.length > 0;

      if (!hasToggles && attemptsLeft > 0) {
        window.setTimeout(() => hideDefaultLayers(awesomeMap, attemptsLeft - 1), 150);
        return;
      }

      ["proposals", "meetings"].forEach((layerName) => {
        const labels = document.querySelectorAll(`.awesome_map-component[data-layer='${layerName}']`);
        labels.forEach((label) => {
          const checkbox = label.closest("label")?.querySelector("input[type='checkbox']");
          if (checkbox) checkbox.checked = false;
        });

        const layer = awesomeMap.layers[layerName];
        if (layer?.group) {
          awesomeMap.map.removeLayer(layer.group);
        }
      });
    };

    const waitForAwesomeMap = () => {
      if (!window.AwesomeMap || !window.AwesomeMap.map || !window.AwesomeMap.cluster) {
        window.setTimeout(waitForAwesomeMap, 150);
        return;
      }

      hideLoadingSpinner(window.AwesomeMap);
      addDistrictCouncilBoundaries(window.AwesomeMap);
      if (!showAccountabilityResults || !components.length) return;

      hideDefaultLayers(window.AwesomeMap);
      components.forEach((component) => {
        const loadingKey = startResultsLoading(window.AwesomeMap, component);
        fetchResults(window.AwesomeMap, component, loadingKey);
      });
    };

    waitForAwesomeMap();
  });
</script>
